  "cards": [
    {
      "dot": "cyan",
      "title": "Layer Ingestion & Data Telemetri",
      "items": [
        "Log mentah web, proxy, dan WAF dialirkan ke indeks Elasticsearch (retensi 90 hari)",
        "Logstash memfilter regex, webshell, dan slot judi lalu mendorong payload ke antrian Redis",
        "Redis mengelola antrian asinkron logstash_alert_queue dan cache status mitigasi"
      ]
    },
    {
      "dot": "emerald",
      "title": "Layer Aplikasi & Decision Engine Terperinci",
      "items": [
        "Daemon Core memvalidasi IP whitelist dan mengecek reputasi AbuseIPDB",
        "Correlation Engine mengagregasi frekuensi serangan ZSET lintas waktu dan meredam badai alert",
        "Playbook Engine mengevaluasi kondisi logika SOP deklaratif berbasis Safe AST tanpa kode berbahaya",
        "ML Classifier mengeksekusi prediksi sub-milidetik (scikit-learn) dan continuous auto-retraining"
      ]
    },
    {
      "dot": "rose",
      "title": "Layer Telegram, Komando SOC & Mitigasi",
      "items": [
        "Triple-Interface Telegram memisahkan kanal siaran alert, audit trail aksi, dan bot DM analis",
        "AI Copilot multi-provider (Gemini, Claude, Ollama) membantu analis melakukan deobfuskasi & RCA",
        "Router mitigasi mengeksekusi blokir terkoordinasi ke firewall, Cloudflare, EDR, dan sistem tiket"
      ]
    }
  ]
