# ==============================================================================
# MiniSOAR .gitignore
# ==============================================================================

# --- Secrets & Sensitive Files ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.secret
*.p12
*.kdbx
secrets/
credentials/
config/local.*

# --- Python & Dependencies ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
ENV*/
venv*/

# --- Logs & PID Tracking ---
*.log
logs/
.pids/
tele-soar-actions.log
minisoar-unmapped-sites.log

# --- OS Specific Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- IDE & Editor Configs ---
.idea/
.vscode/
*.swp
*.swo
*~
*.iml
*.sublime-project
*.sublime-workspace

# --- Testing & Quality Gate Artifacts ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
test-results/
coverage.xml
*.test-output.*

# --- AI & IDE Assistants ---
.agents/
.claude/
.gemini/
.antigravitycli/
.obsidian/
.codex/
.cursor/

# --- Graphify & Codebase Analysis ---
graphify/
.graphify/
.graphify_*
graphify-out/
*.graph.json
*.graph.svg
*.graph.html

# --- Temporary & Dataset Files ---
tmp/
temp/
dataset.csv
minisoar-bypass.txt
minisoar-whitelist.txt
Reports/
*.joblib
!baseline_model.joblib