# === Redis ===
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_KEY=logstash_alert_queue

# === Telegram (WAJIB DIISI) ===
TELEGRAM_BOT=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID
TELEGRAM_PROCESS_CHAT_ID=YOUR_PROCESS_CHAT_ID

# === AbuseIPDB (OPSIONAL) ===
ABUSEIPDB_API_KEY=YOUR_ABUSEIPDB_API_KEY

# === Cache & Timeout (opsional, detik) ===
ABUSEIPDB_CACHE_TTL=21600
IPAPI_CACHE_TTL=43200
LOOKUP_TIMEOUT=4

# === Disable / Enable Block Button ===
#DE_DISABLE_BUTTONS = os.environ.get("DE_DISABLE_BUTTONS", "1")  # 1 untuk menonaktifkan tombol khusus distributed error
#DE_DISABLE_BUTTONS=1

# === Webshell Burst Treshold ===
WEBSHELL_BURST_THRESHOLD=20
#GAMBLING_BURST_THRESHOLD=50

# === BYPASS IP ===
BYPASS_IPS="127.0.0.1,192.168.1.1"

# === Elasticsearch (Phase 0) ===
ES_HOSTS=https://YOUR_ELASTICSEARCH_HOST:9200
ES_USER=YOUR_ES_USER
ES_PASS=YOUR_ES_PASS
ES_VERIFY=false
ES_EVENTS_INDEX_PREFIX=minisoar-events
ES_LABELS_INDEX_PREFIX=minisoar-labels
ES_TIMEOUT=6
MINISOAR_EVENT_WINDOW=60

# === Security Perimeter Credentials ===
# Imperva
IMPERVA_BASE_URL=https://YOUR_IMPERVA_BASE_URL
IMPERVA_USERNAME=YOUR_IMPERVA_USERNAME
IMPERVA_PASSWORD=YOUR_IMPERVA_PASSWORD
IMPERVA_GROUP_NAME=Blocked-IP-Addresses

# Palo Alto
PA_HOST=https://YOUR_PA_HOST
PA_API_KEY=YOUR_PA_API_KEY
PA_VSYS=vsys1
PA_GROUP=YOUR_PA_GROUP
PA_ADMIN=YOUR_PA_ADMIN

# Akamai
AKAMAI_BASEURL=https://YOUR_AKAMAI_BASEURL
AKAMAI_LIST_ID=YOUR_AKAMAI_LIST_ID
AKAMAI_CLIENT_TOKEN=YOUR_AKAMAI_CLIENT_TOKEN
AKAMAI_CLIENT_SECRET=YOUR_AKAMAI_CLIENT_SECRET
AKAMAI_ACCESS_TOKEN=YOUR_AKAMAI_ACCESS_TOKEN
AKAMAI_ACCOUNT_SWITCH=

# Akamai SIEM Config ID untuk query security events (wajib untuk /tracevakamai)
AKAMAI_SIEM_CONFIG_ID=YOUR_AKAMAI_SIEM_CONFIG_ID

# Cloudflare WAF / Edge
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
CLOUDFLARE_ZONE_ID=YOUR_CLOUDFLARE_ZONE_ID

# Fortinet FortiGate Firewall
FORTIGATE_HOST=https://YOUR_FORTIGATE_HOST
FORTIGATE_API_TOKEN=YOUR_FORTIGATE_API_TOKEN
FORTIGATE_VERIFY_SSL=no
FORTIGATE_BLOCK_GROUP=MiniSOAR_Blacklist

# === EDR (Endpoint Detection & Response) Servers ===
# TrendMicro Vision One / Cloud One Workload Security
TRENDMICRO_BASE_URL=https://api.xdr.trendmicro.com
TRENDMICRO_API_KEY=YOUR_TRENDMICRO_API_KEY

# Kaspersky Security Center (KSC) 15.1 OpenAPI
KSC_SERVER_URL=https://YOUR_KSC_HOST:13299/api/v1.0
KSC_USERNAME=YOUR_KSC_USERNAME
KSC_PASSWORD=YOUR_KSC_PASSWORD
KSC_VERIFY_SSL=no

# Safety Policy EDR: 0 = Nonaktifkan isolasi host otomatis (hanya sinkronisasi IoC & isolasi manual bot)
MINISOAR_EDR_ALLOW_AUTO_ISOLATE=0

# === Tier 3: Optional 3rd-Party Ticketing Integration ===
# Provider options: none (default/disabled), thehive, jira, servicenow, webhook
TICKETING_PROVIDER=none

# TheHive 4/5 (Jika TICKETING_PROVIDER=thehive)
THEHIVE_URL=https://YOUR_THEHIVE_URL:9000
THEHIVE_API_KEY=YOUR_THEHIVE_API_KEY
THEHIVE_VERIFY_SSL=no

# Jira Service Management (Jika TICKETING_PROVIDER=jira)
JIRA_URL=https://YOUR_DOMAIN.atlassian.net
JIRA_USER_EMAIL=YOUR_JIRA_EMAIL
JIRA_API_TOKEN=YOUR_JIRA_API_TOKEN
JIRA_PROJECT_KEY=SEC

# ServiceNow ITSM (Jika TICKETING_PROVIDER=servicenow)
SERVICENOW_URL=https://YOUR_INSTANCE.service-now.com
SERVICENOW_USER=YOUR_SERVICENOW_USER
SERVICENOW_PASSWORD=YOUR_SERVICENOW_PASSWORD

# Generic Webhook (Jika TICKETING_PROVIDER=webhook - Zendesk/Freshservice/Slack/Teams)
INCIDENT_WEBHOOK_URL=https://YOUR_WEBHOOK_ENDPOINT

# === Tier 5: AI SOC Copilot (GenAI / LLM) ===
# Provider options: gemini (Google Antigravity), claude (Anthropic), openai (Codex/GPT), ollama (Local)
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# Execution mode: headless (Headless CLI mode with JSON output), sdk (Direct SDK/REST), auto (Headless CLI first with SDK fallback)
AI_EXECMODE=auto
OLLAMA_BASE_URL=http://localhost:11434

# Opsi 1: Direct API Keys
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
ANTHROPIC_API_KEY=YOUR_CLAUDE_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Opsi 2: User-Saved Auth Files (JSON atau Plain Token)
# GEMINI_AUTH_FILE=/path/to/google_credentials.json (atau GOOGLE_APPLICATION_CREDENTIALS)
# CLAUDE_AUTH_FILE=/path/to/claude_auth.json
# OPENAI_AUTH_FILE=/path/to/openai_key.txt
# AI_AUTH_FILE=/path/to/unified_ai_auth.json

# === Mock Mode (1: Aktifkan Mock untuk mitigasi perimeter, EDR & AI, 0: Real API) ===
MINISOAR_MOCK=1

# === Blocking Mode (AUTO: Auto block, SEMI: Recommendation, MANUAL: Operator click, PLAYBOOK: YAML Playbook) ===
MINISOAR_BLOCKING_MODE=AUTO

# === Penjadwalan Commit / Aktivasi (dalam detik, default: 3600) ===
MINISOAR_COMMIT_INTERVAL=3600



